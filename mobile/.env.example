EXPO_PUBLIC_API_BASE_URL=https://recipereborn.com

# Add only after an EAS project is created. This is not a secret.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Native identifiers. Confirm the iOS identifier in Apple Developer before
# creating its app record. The old Android TWA uses a different package.
EXPO_IOS_BUNDLE_IDENTIFIER=com.recipereborn.app
EXPO_ANDROID_PACKAGE=com.recipereborn.app
