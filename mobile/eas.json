{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-qa": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Recipe Reborn QA",
        "EXPO_ANDROID_PACKAGE": "com.recipereborn.app.qa"
      },
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      }
    },
    "preview-qa-arm64": {
      "extends": "preview-qa",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      }
    },
    "play-internal": {
      "distribution": "store",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "play-alpha": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "play-alpha-draft": {
      "android": {
        "applicationId": "com.recipereborn.app",
        "track": "alpha",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    },
    "play-internal": {
      "android": {
        "releaseStatus": "completed",
        "applicationId": "com.recipereborn.app",
        "track": "internal"
      }
    }
  }
}
