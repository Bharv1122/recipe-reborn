3,473]" /><node index="1" text="You" resource-id="" class="android.widget.TextView" package="com.recipereborn.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[287,610][986,365]" /><node index="2" text="How can I keep a frittata from sticking?" resource-id="" class="android.widget.TextView" package="com.recipereborn.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[287,610][986,436]" /><node index="3" text="" resource-id="" class="android.view.ViewGroup" package="com.recipereborn.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[56,610][927,2153]" /><node index="4" text="AI Chef" resource-id="" class="android.widget.TextView" package="com.recipereborn.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,610][887,587]" /><node index="5" text="To prevent a frittata from sticking:&#10;&#10;*   **Use a non-stick pan:** This is the most crucial step. A well-seasoned cast iron or a good quality non-stick skillet works best.&#10;*   **Properly preheat the pan:** Heat your pan over medium heat *before* adding oil or butter.&#10;*   **Adequate fat:** Use enough oil or butter to coat the bottom of the pan evenly. Swirl it around.&#10;*   **Don't overcrowd:** Too many fillings can steam the bottom and make it stick.&#10;*   **Gentle cooking:** Avoid high heat, which can scorch the bottom. Cook over medium-low heat.&#10;*   **Loosen edges:** Before attempting to flip or slide it out, gently run a spatula around the edges to ensure it's not sticking.&#10;*   **Broiler finish:** If you finish your frittata under the broiler, ensure the pan is oven-safe and that the top is set before moving it." resource-id="" class="android.widget.TextView" package="com.recipereborn.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,610][887,1978]" /><node index="6" text="" resource-id="" class="android.widget.Button" package="com.recipereborn.app" content-desc="Report this reply" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1990][415,2114]"><node index="0" text="Report this reply" resource-id="" class="android.widget.TextView" package="com.recipereborn.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[106,2024][404,2078]" /></node><node index="7" text="" resource-id="" class="android.widget.Button" package="com.recipereborn.app" content-desc="Clear AI Chef history" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]"><node index="0" text="Clear chat history" resource-id="" class="android.widget.TextView" package="com.recipereborn.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /></node></node></node></node></node></node></node></node></node></node></node></node></node><node index="1" t